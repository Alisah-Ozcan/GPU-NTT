// Generated by CMake from cmake/config.cuh.in: the settings GPU-NTT was built
// with, so code that includes the headers without CMake sees the same ones.

#ifndef GPUNTT_CONFIG_H
#define GPUNTT_CONFIG_H

#define GPUNTT_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define GPUNTT_VERSION_MINOR @PROJECT_VERSION_MINOR@

// GPU architectures the library is compiled for (CMAKE_CUDA_ARCHITECTURES).
#define GPUNTT_CUDA_ARCHITECTURES "@CMAKE_CUDA_ARCHITECTURES@"

// Kernel tables tuned for compute capability 8.9 for ring sizes 2^27 and
// 2^28 (CMake option GPUNTT_CC_89_KERNEL_CONFIG).
#ifndef GPUNTT_CC_89_KERNEL_CONFIG
#cmakedefine GPUNTT_CC_89_KERNEL_CONFIG
#endif

#endif // GPUNTT_CONFIG_H
